generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Employee {
  id         BigInt   @id @default(autoincrement())
  name       String
  email      String   @unique
  role       String
  created_at DateTime @default(now())

  @@map("employee")
}
